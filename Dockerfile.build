ARG BASE_IMAGE=debian:bookworm
FROM ${BASE_IMAGE}

# build argument to specify target architecture
ARG TARGET_ARCH=aarch64-unknown-linux-gnu
# extra cargo flags (e.g. --no-default-features) passed to the build command
ARG CARGO_EXTRA_FLAGS=""
# git short sha of the checkout this binary was built from - the build
# context has no .git (see .dockerignore), so rathole/build.rs's own git-
# command fallback always misses here; the Makefile passes this in as the
# real value (mirrors Dockerfile.tauri's identical convention).
ARG FREQHOLE_GIT_SHA=unknown

# install build dependencies
# bullseye (build-pi32's BASE_IMAGE) is oldoldstable now. root cause
# (confirmed by testing FOUR different apt source configs - deb.debian.org
# as-is, minus -security, minus -security+-updates, archive.debian.org's
# frozen snapshot, snapshot.debian.org pinned to a past date - all four
# produced the exact SAME conflict with the exact same version numbers):
# this isn't a repo/suite selection problem at all. the `debian:bullseye`
# DOCKER IMAGE ITSELF already has libc6/libssl1.1/perl-base baked in at
# newer point-release versions (Debian's official image keeps getting
# rebuilt with newer point releases even for an oldoldstable tag), while
# EVERY apt source that still has "-dev"/`perl` companion packages
# available only offers OLDER versions with a hard `Depends: foo (=
# <old version>)` pin - normally `-security` bridged that gap by shipping
# matching newer -dev/perl builds in lockstep with runtime lib security
# patches, but its package files are now 404 everywhere (see repo memory
# tomb-pi32-bullseye-security-archive-eol.md) so that bridge is gone.
# apt won't downgrade an already-installed package on its own even with
# `--allow-downgrades` (that just permits it, doesn't request it) - so
# explicitly install the runtime libs at the exact OLDER version their
# -dev/perl companions actually demand (read straight off apt's own
# conflict report), forcing the downgrade. archive.debian.org's frozen
# bullseye snapshot (already used by the armhf-specific alsa pin further
# below, for the same underlying reason) is the sole source here too -
# it's a genuine point-in-time capture, so its own main-suite -dev/perl
# packages and the exact runtime versions pinned below come from the
# same consistent snapshot. `check-valid-until=no` is required (archived
# Release files carry a long-expired Valid-Until).
#
# a SECOND, much larger round of the exact same skew (confirmed for real
# 2026-10-03, reproduced locally via `docker run --platform linux/amd64
# debian:bullseye`): adding the armhf architecture later in this file
# (`dpkg --add-architecture armhf`, for pi32's cross-compile) makes apt
# re-resolve the ENTIRE dependency graph from scratch, which drags every
# other already-skewed-but-previously-quiet package into the open too -
# `libmpv-dev:armhf` alone (confirmed by bisecting against
# `gcc-arm-linux-gnueabihf` and the alsa trio in isolation, neither of
# which triggers anything) is enough to trip it, via its own transitive
# `libgnutls30` -> `libtasn1-6`/`libgssapi-krb5-2` -> `libpam-modules` ->
# `login`/`passwd` -> `util-linux` dependency chain. apt's solver's last
# resort when it can't reconcile a skewed package in that chain is to
# propose removing it and everything that (quietly, correctly) depends
# on it - cascading all the way up to `apt` itself depending on
# `libgnutls30`, hence "Essential packages were removed". same fix as
# above: pin every package in that chain at the older archived version
# apt's own conflict report names, found exhaustively (not just reactively
# one error at a time) by diffing every installed package's version
# against archive.debian.org's across a clean container.
#
# this is a bullseye-ONLY problem - bookworm (build-pi/build-linux's
# BASE_IMAGE) has no such skew and none of these exact bullseye/debian11
# version strings even exist there (`apt-get install foo=<bullseye
# version>` on bookworm fails outright with "Version ... was not found" -
# a real regression this fix caused the first time, since it was applied
# unconditionally instead of gated to bullseye), so the two base images
# get genuinely different install commands, not just a conditionally-
# skipped sources.list rewrite.
RUN if grep -qi bullseye /etc/apt/sources.list 2>/dev/null || grep -Rqi bullseye /etc/apt/sources.list.d 2>/dev/null; then \
    rm -f /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; \
    echo "deb [check-valid-until=no] http://archive.debian.org/debian bullseye main" > /etc/apt/sources.list; \
    apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get install -y --allow-downgrades \
    curl \
    build-essential \
    pkg-config \
    libc6=2.31-13+deb11u11 \
    libc6-dev=2.31-13+deb11u11 \
    libc-bin=2.31-13+deb11u11 \
    libssl1.1=1.1.1w-0+deb11u1 \
    libssl-dev=1.1.1w-0+deb11u1 \
    perl-base=5.32.1-4+deb11u3 \
    perl=5.32.1-4+deb11u3 \
    dpkg=1.20.13 \
    e2fsprogs=1.46.2-2 \
    libcom-err2=1.46.2-2 \
    libss2=1.46.2-2 \
    libext2fs2=1.46.2-2 \
    logsave=1.46.2-2 \
    login=1:4.8.1-1 \
    passwd=1:4.8.1-1 \
    libgnutls30=3.7.1-5+deb11u5 \
    libtasn1-6=4.16.0-2+deb11u1 \
    libgssapi-krb5-2=1.18.3-6+deb11u5 \
    libk5crypto3=1.18.3-6+deb11u5 \
    libkrb5-3=1.18.3-6+deb11u5 \
    libkrb5support0=1.18.3-6+deb11u5 \
    libsystemd0=247.3-7+deb11u5 \
    libudev1=247.3-7+deb11u5 \
    liblzma5=5.2.5-2.1~deb11u1 \
    libpam0g=1.4.0-9+deb11u1 \
    libpam-runtime=1.4.0-9+deb11u1 \
    libpam-modules=1.4.0-9+deb11u1 \
    libpam-modules-bin=1.4.0-9+deb11u1 \
    libsepol1=3.1-1 \
    gpgv=2.2.27-2+deb11u2 \
    libasound2-dev; \
    else \
    apt-get update && \
    apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    libasound2-dev \
    libmpv-dev; \
    fi

# install cross-compilation tools for ARM64 (aarch64)
# libmpv-dev:arm64 - verified via a real dry-run against this exact base
# image (2026-09-29) that its full ~15-package dependency chain resolves
# cleanly from the live bookworm mirror, same as libasound2-dev below.
RUN if [ "$TARGET_ARCH" = "aarch64-unknown-linux-gnu" ]; then \
    dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y \
    libssl-dev:arm64 \
    libasound2-dev:arm64 \
    libmpv-dev:arm64 \
    gcc-aarch64-linux-gnu; \
    fi

# install cross-compilation tools for ARMv7 (32-bit Pi 2+)
# no libssl-dev:armhf here - pi32's build passes --no-default-features
# (see Makefile's build-pi32), which drops both `server`/`cli`'s own
# "webauthn" default and disables it workspace-wide for this invocation,
# so openssl/openssl-sys/webauthn-rs never enter the dependency graph for
# this target (verified via `cargo tree -p server -p cli
# --no-default-features --target armv7-unknown-linux-gnueabihf -i
# openssl-sys` returning no matches). libasound2-dev:armhf/libmpv-dev:armhf
# stay: rathole's own libmpv-playback (audio + radio + video) pulls both
# in unconditionally via `client/rathole`'s own dependency on grimoire
# (cli depends on rathole as a normal, non-optional dependency, so cli's
# own --no-default-features doesn't reach it).
#
# bullseye is now oldoldstable and its -security pool's newest armhf
# builds of alsa-lib (libasound2/-data/-dev, deb11u1 security patch) have
# been pulled from every live mirror (deb.debian.org, ftp.us/de.debian.org,
# kernel.org all 404 - confirmed, not a transient CDN blip) while the apt
# index still advertises them - an in-progress, not-yet-finished archival
# migration. archive.debian.org's frozen main pool still has the
# pre-security-patch build (1.2.4-1.1, no +deb11uN suffix), so pull just
# that trio from there instead, pinned exactly (all three together, since
# libasound2-data has a Breaks against an older libasound2 than its own
# version - installing them at mismatched versions fails to resolve).
#
# libclang-dev: libmpv2-sys's one pregenerated bindings.rs assumes a
# 64-bit pointer width (its bindgen-emitted layout assertions hard-code
# 64-bit struct sizes) and fails to compile outright on this 32-bit
# target - grimoire/Cargo.toml's `[target.'cfg(target_arch = "arm")']`
# section forces that crate's own `use-bindgen` feature here instead, so
# bindings get regenerated live against the real (32-bit) target layout.
# that needs a real libclang to parse mpv's C headers at build time.
RUN if [ "$TARGET_ARCH" = "armv7-unknown-linux-gnueabihf" ]; then \
    dpkg --add-architecture armhf && \
    echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20250501T000000Z bullseye main" > /etc/apt/sources.list.d/archive-bullseye.list && \
    apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get install -y \
    libasound2-data=1.2.4-1.1 \
    libasound2:armhf=1.2.4-1.1 \
    libasound2-dev:armhf=1.2.4-1.1 \
    libmpv-dev:armhf \
    gcc-arm-linux-gnueabihf \
    libclang-dev; \
    fi

# clean up apt cache
RUN rm -rf /var/lib/apt/lists/*

# install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# add the target architecture
RUN rustup target add $TARGET_ARCH

# set cross-compilation linkers
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc

# allow pkg-config to find the multiarch libs we installed above
# (`libssl-dev:armhf`, `libasound2-dev:armhf`, etc.). without this, alsa-sys
# and openssl-sys panic with "pkg-config has not been configured to support
# cross-compilation".
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV PKG_CONFIG_PATH_aarch64_unknown_linux_gnu=/usr/lib/aarch64-linux-gnu/pkgconfig
ENV PKG_CONFIG_PATH_armv7_unknown_linux_gnueabihf=/usr/lib/arm-linux-gnueabihf/pkgconfig

# libmpv2-sys's own `use-bindgen` codepath (armv7 only - see
# grimoire/Cargo.toml) invokes clang against the target's C headers -
# clang auto-detects the cross target itself (bindgen passes it via
# Cargo's own TARGET env var), but doesn't know Debian's multiarch layout
# puts triplet-specific headers in their own subdirectory, so plain
# `/usr/include/stdint.h`'s `#include <bits/libc-header-start.h>` fails
# outright (confirmed for real 2026-10-03). BINDGEN_EXTRA_CLANG_ARGS is a
# global (not per-target) bindgen env var, but that's fine here -
# libmpv2-sys is the only crate in this image enabling bindgen at all,
# for only this one target.
ENV BINDGEN_EXTRA_CLANG_ARGS="-I/usr/include/arm-linux-gnueabihf"

RUN find /usr -maxdepth 4 -iname '*gnueabihf*' 2>/dev/null; find / -maxdepth 2 -iname '*gnueabihf*' 2>/dev/null; find / -name 'libc-header-start.h' 2>/dev/null

WORKDIR /app
COPY . .

# build server and cli for the specified target architecture
RUN SQLX_OFFLINE="true" FREQHOLE_GIT_SHA=${FREQHOLE_GIT_SHA} cargo build --release --target $TARGET_ARCH -p server -p cli $CARGO_EXTRA_FLAGS
