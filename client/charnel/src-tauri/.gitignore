# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas
bin/

# staged by scripts/fetch-mpv-runtime.sh, bundled at build time - not checked in
/mpv-runtime/lib/
# the bundled dylib closures ARE checked in though (see
# scripts/fetch-mpv-runtime.sh's stage_from_committed) - lets CI/fresh
# checkouts reuse a prebuilt bundle instead of rebuilding mpv from source
# every run.
!/mpv-runtime/committed/
# windows: scripts/windows/fetch-mpv-runtime.ps1 downloads these fresh
# every build (checksum-pinned release archives, no local "committed"
# snapshot needed the way macOS's from-source mpv build benefits from) -
# not checked in.
/mpv-runtime/libmpv-2.dll
/mpv-runtime/ffmpeg.exe
/mpv-runtime/ffprobe.exe
/mpv-runtime/.fetched-*
# regenerated by scripts/fetch-mpv-runtime.sh every arm64 build (the exact
# bundled dylib filenames drift with homebrew's own package versions) -
# not checked in
/tauri.macos.conf.json
