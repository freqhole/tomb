{
  "name": "charnel",
  "version": "0.3.20",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:wizard": "vite --port 1421",
    "dev:all": "concurrently -n wizard,spume -c cyan,magenta \"npm run dev:wizard\" \"node scripts/dev-spume-for-charnel.mjs\"",
    "build": "vite build",
    "build:wizard": "vite build --outDir dist/wizard",
    "serve": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@solidjs/router": "^0.15.4",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "monaco-editor": "^0.57.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.12"
  }
}
