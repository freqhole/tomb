{
  "name": "freqhole-client",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:full": "ESLINT_FULL=true eslint src --ext .ts,.tsx",
    "lint:full:fix": "ESLINT_FULL=true eslint src --ext .ts,.tsx --fix",
    "lint:circular": "npx madge --circular --extensions ts,tsx src/",
    "ts-prune": "ts-prune",
    "lint:quiet": "eslint src --ext .ts,.tsx --quiet",
    "check": "npm run typecheck && npm run lint:quiet && echo CHECK_OK",
    "verify": "npm run check && npm run test && echo VERIFY_OK",
    "build:coach:wc": "vite build --config vite.coach-demo.config.ts --mode wc",
    "build:coach:html": "vite build --config vite.coach-demo.config.ts --mode html",
    "dev:coach": "vite --config vite.coach-demo.config.ts --mode html stories/coach"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.2.7",
    "@freqhole/api-client": "file:../../client-codegen/freqhole-api-client",
    "@freqhole/haruspex": "file:../../lib/haruspex/ts",
    "@freqhole/midden": "file:../../lib/midden/pkg",
    "@freqhole/playlistz": "^0.0.6",
    "@freqhole/reliquary": "file:../../lib/reliquary/ts",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^0.15.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@tanstack/solid-query": "^5.103.1",
    "@tanstack/solid-virtual": "^3.13.40",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/node": "^25.3.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/browser": "^4.0.17",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.6.1",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "eslint": "^9.0.0",
    "eslint-plugin-solid": "^0.18.0",
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.3",
    "jsdom": "^29.1.1",
    "music-metadata": "^11.12.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "solid-js": "^1.9.11",
    "storybook": "^10.5.10",
    "storybook-solidjs-vite": "^10.7.2",
    "tailwindcss": "^4.2.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.17",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@swc/core": "1.15.47",
    "@swc/wasm": "1.15.30"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": false,
    "printWidth": 100,
    "tabWidth": 2,
    "jsxSingleQuote": false
  }
}
