[Unit]
# managed by freqhole-pi setup
Description=rathole SSH terminal session
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
Environment=HOME=@HOME@
Environment=TERM=xterm-256color
ExecStartPre=/usr/bin/python3 @ROOT@/charnel.py rathole-launch
ExecStart=/usr/bin/tmux -D -S @ROOT@/tmux.sock -f @ROOT@/tmux.conf
ExecStop=/usr/bin/tmux -S @ROOT@/tmux.sock kill-server
Restart=no
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
