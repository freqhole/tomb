#!/bin/sh
# NetworkManager owns saved networks; never restart it or delete user profiles.
set -eu
connection="$(/usr/bin/nmcli -g GENERAL.CON-UUID device show "$PORTAL_INTERFACE")"
if [ -n "$connection" ] && [ "$connection" != -- ]; then
    mode="$(/usr/bin/nmcli -g 802-11-wireless.mode connection show uuid "$connection")"
    if [ "$mode" = ap ]; then
        ssid="$(/usr/bin/nmcli -g 802-11-wireless.ssid connection show uuid "$connection")"
        if [ "$ssid" != "$PORTAL_SSID" ]; then
            echo "another access point is active; leaving it unchanged." >&2
            exit 1
        fi
        /usr/bin/nmcli --wait 5 connection delete uuid "$connection"
    fi
fi
state="$(/usr/bin/nmcli -g GENERAL.STATE device show "$PORTAL_INTERFACE")"
case "$state" in
    100*) exit 0 ;;
    30*)
        if ! /usr/bin/nmcli --wait 10 device connect "$PORTAL_INTERFACE"; then
            echo "wifi setup ended; no saved network reconnected. start the portal again to configure one." >&2
            exit 1
        fi
        ;;
    *) echo "wifi interface is not connected after portal exit; inspect NetworkManager." >&2; exit 1 ;;
esac
