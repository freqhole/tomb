#!/bin/bash
# rathole release management/session access; run as the installation owner.
set -euo pipefail

usage() {
    cat <<'EOF'
usage: freqhole-pi <command> [charnel]

rathole:
  check             check for a newer stable release without installing
  status            report installed/available versions and update status as JSON
  install           install the latest stable release (used by setup)
  update            install a newer release; restart only if already running
  attach            connect to tmux; offer to start if stopped; Ctrl+B, D detaches
  start             start the configured rathole service
  stop              stop the rathole service
  restart           restart the rathole service

system controls:
  enable            pick startup entries to enable (Enter: all); does not start
  disable           pick startup entries to disable and stop (Enter: all)
  poweroff          shut down the Pi
  wifi-start        start the optional Wi-Fi setup portal (may interrupt SSH)
  wifi-stop         stop the Wi-Fi setup portal

charnel:
  check charnel     check for a newer stable release without installing
  status charnel    report installed/available versions and update status as JSON
  update charnel    back up, update and migrate; restart only if already running
  recover charnel   restore the previous package/data after an unfinished update

pi scripts (OLED menu, helpers, services; follows the git ref setup.sh used):
  check scripts     check for newer pi scripts without installing
  status scripts    report installed/available script trees as JSON
  update scripts    install newer pi scripts; config/data are kept
  (check and update for rathole/charnel also check/update the pi scripts afterward)

setup hooks (normally called automatically):
  launch charnel    validate managed startup and configure the control socket
  socket charnel    configure the selected app's control socket

  help, -h, --help   show this help (also shown with no arguments)
EOF
}

if [ "$#" -eq 0 ]; then usage; exit 0; fi
case "$1" in
    help|-h|--help)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        usage
        exit 0
        ;;
esac

die() { echo "$*" >&2; exit 1; }

render() {
    sed -e "s|@USER@|$(id -un)|g" -e "s|@UID@|$(id -u)|g" -e "s|@HOME@|$HOME|g" \
        -e "s|@ROOT@|$HOME/.local/share/freqhole-pi|g" "$1"
}

# replaces $2 with $1 via a same-directory rename; returns 1 when already identical.
install_user_file() {
    local source="$1" destination="$2" mode="$3" staged
    if [ -f "$destination" ] && cmp -s "$source" "$destination"; then return 1; fi
    staged="$(mktemp "$(dirname "$destination")/.${destination##*/}.XXXXXX")"
    install -m "$mode" "$source" "$staged"
    mv -f "$staged" "$destination"
}

scripts_files=(menu.py storage_menu.py requirements.txt configure.py packages.py charnel.py splash.py freqhole-pi
    freqhole-pi-control rathole.service rathole-tmux.service rathole-ctrl.service tmux.conf
    freqhole-wifi freqhole-wifi.service freqhole-pi-wifi-recover charnel.service charnel-session)

# pi scripts track the scripts/raspberry-pi tree at the git ref setup.sh installed
# from (recorded in scripts.json), so unrelated repo commits never count as updates.
scripts_action() {
    local action="$1" root="$HOME/.local/share/freqhole-pi" ref=main installed=none
    local record revision tree newer file index=0 unit template staged entry source destination mode
    local -a changed=() system=() names=()
    for tool in curl jq flock cmp sed install python3; do
        command -v "$tool" >/dev/null || die "missing $tool; run setup.sh first."
    done
    record="$root/scripts.json"
    if [ -f "$record" ]; then
        ref="$(jq -er '.ref' "$record")" || die "scripts record has no ref."
        installed="$(jq -er '.tree' "$record")" || die "scripts record has no tree."
    fi
    [[ "$ref" =~ ^[a-zA-Z0-9._-]+$ ]] || die "invalid scripts ref in $record."
    mkdir -p "$root"
    if [ "$action" = update ]; then
        exec 9>"$root/update.lock"
        flock -n 9 || die "another setup/update is running."
    fi
    work="$(mktemp -d "$root/scripts-update.XXXXXX")"
    trap 'rm -rf -- "$work"' EXIT
    [ "$action" = status ] || echo "checking pi scripts ($ref)..."
    curl -fsSL --retry 1 --connect-timeout 5 --max-time 15 \
        "https://api.github.com/repos/freqhole/tomb/commits/$ref" -o "$work/commit.json"
    revision="$(jq -er '.sha' "$work/commit.json")" || die "commit response has no sha."
    [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || die "invalid GitHub revision."
    curl -fsSL --retry 1 --connect-timeout 5 --max-time 15 \
        "https://api.github.com/repos/freqhole/tomb/contents/scripts?ref=$revision" -o "$work/contents.json"
    tree="$(jq -er '.[] | select(.name == "raspberry-pi" and .type == "dir") | .sha' "$work/contents.json")" \
        || die "could not find scripts/raspberry-pi at $ref."
    [[ "$tree" =~ ^[0-9a-f]{40}$ ]] || die "invalid scripts tree."
    newer=true
    if [ "$installed" = "$tree" ] || [ "$installed" = local ]; then newer=false; fi
    if [ "$action" = status ]; then
        jq -n --arg installed "${installed:0:7}" --arg available "${tree:0:7}" --argjson newer "$newer" \
            '{installed: $installed, available: $available, update_available: $newer}'
        return
    fi
    echo "pi scripts: installed ${installed:0:7}; available ${tree:0:7}"
    if [ "$installed" = local ]; then
        echo "pi scripts came from a local checkout; rerun its setup.sh, or delete $record to follow $ref."
        return
    fi
    if ! "$newer"; then echo "pi scripts are up to date."; return; fi
    if [ "$action" = check ]; then
        echo "update available; run: freqhole-pi update scripts"
        return
    fi

    for file in "${scripts_files[@]}"; do
        index=$((index + 1))
        echo "downloading $file ($index/${#scripts_files[@]})..."
        curl -fsSL --retry 2 --connect-timeout 15 --max-time 60 \
            "https://raw.githubusercontent.com/freqhole/tomb/$revision/scripts/raspberry-pi/$file" -o "$work/$file"
    done
    echo "checking downloaded scripts..."
    for file in menu.py storage_menu.py configure.py packages.py charnel.py splash.py freqhole-wifi; do
        python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$work/$file" \
            || die "downloaded $file does not parse; nothing was installed."
    done
    for file in freqhole-pi charnel-session; do
        bash -n "$work/$file" || die "downloaded $file does not parse; nothing was installed."
    done
    for file in freqhole-pi-control freqhole-pi-wifi-recover; do
        sh -n "$work/$file" || die "downloaded $file does not parse; nothing was installed."
    done

    echo "installing pi scripts..."
    for file in menu.py storage_menu.py requirements.txt configure.py packages.py charnel.py splash.py; do
        if install_user_file "$work/$file" "$root/$file" 644; then changed+=("$file"); fi
    done
    # bash already holds the running copy open; the rename only affects later runs.
    if install_user_file "$work/freqhole-pi" "$HOME/.local/bin/freqhole-pi" 755; then changed+=(freqhole-pi); fi
    for file in charnel-session freqhole-wifi; do
        if [ -f "$HOME/.local/bin/$file" ] && install_user_file "$work/$file" "$HOME/.local/bin/$file" 755; then
            changed+=("$file")
        fi
    done
    if [ -f "$root/tmux.conf" ]; then
        render "$work/tmux.conf" > "$work/tmux-rendered.conf"
        if install_user_file "$work/tmux-rendered.conf" "$root/tmux.conf" 600; then changed+=(tmux.conf); fi
    fi
    unit="$(dirname "$(jq -er '.charnel_config // empty' "$root/installation.json" 2>/dev/null || echo "$HOME/.config/x")")"
    unit="$unit/systemd/user/charnel.service"
    if [ -f "$unit" ] && grep -qx '# managed by freqhole-pi setup' "$unit"; then
        # setup appends a blank line, [Service] and two XDG Environment= lines; keep them.
        if [ "$(tail -n 3 "$unit" | head -n 1)" = "[Service]" ]; then
            { cat "$work/charnel.service"; tail -n 4 "$unit"; } > "$work/charnel-rendered.service"
            if install_user_file "$work/charnel-rendered.service" "$unit" 644; then
                changed+=(charnel.service)
                systemctl --user daemon-reload || echo "could not reload user services; log out and back in."
            fi
        else
            echo "charnel.service has unexpected local edits; rerun setup.sh to refresh it."
        fi
    fi
    if [[ " ${changed[*]:-} " == *" requirements.txt "* ]] && [ -x "$root/.venv/bin/python3" ]; then
        echo "updating OLED menu python packages..."
        "$root/.venv/bin/python3" -m pip install --progress-bar off -r "$root/requirements.txt"
    fi

    queue_system() {
        [ -f "$2" ] || return 0
        cmp -s "$1" "$2" && return 0
        system+=("$1|$2|$3")
    }
    queue_system "$work/freqhole-pi-control" /usr/local/libexec/freqhole-pi-control 755
    queue_system "$work/packages.py" /usr/local/libexec/freqhole-pi-packages 755
    queue_system "$work/freqhole-pi-wifi-recover" /usr/local/libexec/freqhole-pi-wifi-recover 755
    if grep -qsx '# managed by freqhole-pi setup' /etc/systemd/system/freqhole-wifi.service; then
        queue_system "$work/freqhole-wifi.service" /etc/systemd/system/freqhole-wifi.service 644
    fi
    if grep -qsx '# managed by freqhole-pi setup' /etc/systemd/system/rathole.service; then
        template=rathole.service
        if grep -q tmux /etc/systemd/system/rathole.service; then template=rathole-tmux.service; fi
        render "$work/$template" > "$work/rathole-rendered.service"
        queue_system "$work/rathole-rendered.service" /etc/systemd/system/rathole.service 644
    fi
    if grep -qsx '# managed by freqhole-pi setup' /etc/systemd/system/rathole-ctrl.service; then
        render "$work/rathole-ctrl.service" > "$work/rathole-ctrl-rendered.service"
        queue_system "$work/rathole-ctrl-rendered.service" /etc/systemd/system/rathole-ctrl.service 644
    fi
    local pending=false
    if [ "${#system[@]}" -gt 0 ]; then
        # the menu's sudoers entry only covers fixed control actions; system files
        # need full passwordless sudo (the Raspberry Pi OS default) or a setup rerun.
        if sudo -n true 2>/dev/null; then
            echo "updating system files..."
            for entry in "${system[@]}"; do
                IFS='|' read -r source destination mode <<< "$entry"
                echo "updating ${destination##*/}..."
                sudo -n install -o root -g root -m "$mode" "$source" "$destination"
                changed+=("${destination##*/}")
            done
            sudo -n systemctl daemon-reload
        else
            pending=true
            for entry in "${system[@]}"; do
                IFS='|' read -r source destination mode <<< "$entry"
                names+=("${destination##*/}")
            done
            echo "system files need sudo; rerun setup.sh to apply: ${names[*]}"
        fi
    fi

    jq -n --arg ref "$ref" --arg revision "$revision" --arg tree "$tree" \
        '{ref: $ref, revision: $revision, tree: $tree}' > "$work/scripts.json"
    install -m 600 "$work/scripts.json" "$record"
    if [ "${#changed[@]}" -gt 0 ]; then echo "changed: ${changed[*]:-}"; fi
    local restart_menu=false
    for file in menu.py storage_menu.py configure.py requirements.txt; do
        if [[ " ${changed[*]:-} " == *" $file "* ]]; then restart_menu=true; fi
    done
    if "$restart_menu"; then
        if [ -n "${FREQHOLE_PI_MENU:-}" ]; then
            # protocol line: the OLED menu restarts itself after showing the result.
            echo "menu: restart"
        elif [ -f /etc/systemd/system/rathole-ctrl.service ] && systemctl is-active --quiet rathole-ctrl.service; then
            if sudo -n systemctl restart rathole-ctrl.service 2>/dev/null; then
                echo "restarted the OLED menu."
            else
                echo "restart the OLED menu to load it: sudo systemctl restart rathole-ctrl"
            fi
        fi
    fi
    if "$pending"; then
        echo "pi scripts ${tree:0:7} installed; rerun setup.sh for system files."
    else
        echo "pi scripts updated to ${tree:0:7}."
    fi
}

if [ "${2:-}" = scripts ]; then
    [ "$#" -eq 2 ] || { echo "usage: freqhole-pi check|status|update scripts" >&2; exit 2; }
    case "$1" in check|status|update) ;; *) usage >&2; exit 2 ;; esac
    [ "$(id -u)" -ne 0 ] || die "run freqhole-pi as your regular user, without sudo."
    scripts_action "$1"
    exit 0
fi
# app checks/updates run first; the pi scripts tag along only when they succeed.
if [ -z "${FREQHOLE_PI_APP_ONLY:-}" ] && { [ "$1" = check ] || [ "$1" = update ]; } \
    && { [ "$#" -eq 1 ] || { [ "$#" -eq 2 ] && [ "$2" = charnel ]; }; }; then
    FREQHOLE_PI_APP_ONLY=1 "${BASH_SOURCE[0]}" "$@"
    echo
    exec "${BASH_SOURCE[0]}" "$1" scripts
fi
if [ "${2:-}" = charnel ]; then
    [ "$#" -eq 2 ] || { echo "usage: freqhole-pi check|status|update|recover charnel" >&2; exit 2; }
    exec python3 "$HOME/.local/share/freqhole-pi/charnel.py" "$1"
fi
[ "$#" -le 1 ] || { usage >&2; exit 2; }

manage_startup() {
    local operation="$1" unit path state selection index entry config_home autostart
    local -a entries=() labels=() selected=()
    for entry in rathole menu wifi; do
        case "$entry" in
            rathole) unit=rathole.service ;;
            menu) unit=rathole-ctrl.service ;;
            wifi)
                [ "$operation" = disable ] || continue
                unit=freqhole-wifi.service
                ;;
        esac
        path="/etc/systemd/system/$unit"
        if [ -f "$path" ] && grep -qx '# managed by freqhole-pi setup' "$path"; then
            state="$(systemctl show "$unit" -p UnitFileState --value)" || die "could not inspect $unit"
            entries+=("$entry")
            labels+=("$unit ($state)")
        fi
    done
    config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    if [ -f "$HOME/.local/share/freqhole-pi/installation.json" ]; then
        config_home="$(python3 -c 'import json, pathlib; print(pathlib.Path(json.loads(pathlib.Path.home().joinpath(".local/share/freqhole-pi/installation.json").read_text())["charnel_config"]).parent)')"
    fi
    path="$config_home/systemd/user/charnel.service"
    autostart="$config_home/autostart/freqhole-pi-charnel.desktop"
    if [ -f "$path" ] && grep -qx '# managed by freqhole-pi setup' "$path"; then
        state=disabled
        if [ -f "$autostart" ]; then
            grep -qx '# managed by freqhole-pi setup' "$autostart" \
                || die "charnel desktop autostart is unmanaged; refusing to overwrite it."
            state=enabled
        fi
        entries+=(charnel)
        labels+=("charnel desktop login ($state)")
    fi
    echo "Wi-Fi provisioning stays manual-only; enable never adds it to boot."
    [ "${#entries[@]}" -gt 0 ] || { echo "no managed entries available."; return; }
    for index in "${!entries[@]}"; do printf '%s) %s\n' "$((index + 1))" "${labels[$index]}"; done
    read -r -p "$operation: Enter for all, numbers separated by spaces, or q to cancel: " selection || return 0
    [ "$selection" != q ] || return 0
    if [ -z "$selection" ]; then
        selected=("${entries[@]}")
    else
        local -a choices
        read -r -a choices <<< "$selection"
        [ "${#choices[@]}" -gt 0 ] || die "select at least one entry."
        for index in "${choices[@]}"; do
            if ! [[ "$index" =~ ^[1-9][0-9]?$ ]] || [ "$index" -gt "${#entries[@]}" ]; then
                die "invalid selection: $index; nothing changed."
            fi
            selected+=("${entries[$((index - 1))]}")
        done
    fi
    for entry in "${selected[@]}"; do
        if [ "$entry" = charnel ]; then
            if [ "$operation" = disable ]; then
                systemctl --user stop charnel.service
                if [ -f "$autostart" ]; then rm -- "$autostart"; fi
            else
                mkdir -p "$(dirname "$autostart")"
                printf '[Desktop Entry]\n# managed by freqhole-pi setup\nType=Application\nName=charnel\nExec=%s/.local/bin/charnel-session\nTerminal=false\n' \
                    "$HOME" > "$autostart"
                chmod 644 "$autostart"
            fi
        else
            sudo -n /usr/local/libexec/freqhole-pi-control "$operation-$entry"
        fi
        echo "$entry: $operation complete."
    done
}

if [ "$(id -u)" -eq 0 ]; then
    die "run freqhole-pi as your regular user, without sudo."
fi
action="$1"
case "$action" in
    enable|disable)
        manage_startup "$action"
        exit 0
        ;;
    start|stop|restart|poweroff|wifi-start|wifi-stop)
        exec sudo -n /usr/local/libexec/freqhole-pi-control "$action"
        ;;
    attach)
        command -v tmux >/dev/null || die "tmux is not installed; choose SSH/tmux in setup.sh first."
        tips_dismissed="$HOME/.local/share/freqhole-pi/tmux-tips-dismissed"
        if [ ! -f "$tips_dismissed" ]; then
            cat <<'EOF'
tmux quick help (release Ctrl+B before pressing the next key):
  Ctrl+B, D     detach; rathole keeps running
  Ctrl+B, [     scrollback mode; arrow/Page Up keys scroll, Q exits
  Ctrl+B, ?     list tmux shortcuts; Q exits
reconnect later with: freqhole-pi attach
EOF
            if ! read -r -n 1 -p "press enter to continue, n to never see this message again; any other key to exit. " answer; then
                echo
                exit 0
            fi
            echo
            case "$answer" in
                "") ;;
                n|N)
                    mkdir -p "$(dirname "$tips_dismissed")"
                    (umask 077; touch "$tips_dismissed") \
                        || die "could not save the tmux help preference."
                    ;;
                *) exit 0 ;;
            esac
        fi
        socket="$HOME/.local/share/freqhole-pi/tmux.sock"
        if ! tmux -S "$socket" has-session -t '=rathole' 2>/dev/null; then
            echo "no managed rathole tmux session."
            service_command="$(systemctl show rathole.service --property=ExecStart --value)" \
                || die "could not inspect rathole.service."
            [[ "$service_command" == *"/usr/bin/tmux -D -S $socket -f $HOME/.local/share/freqhole-pi/tmux.conf"* ]] \
                || die "rathole is not configured for SSH/tmux; rerun setup.sh and select that mode."
            if ! read -r -n 1 -p "press enter to start; any other key to exit. " answer; then
                echo
                exit 0
            fi
            echo
            [ -z "$answer" ] || exit 0
            sudo -n /usr/local/libexec/freqhole-pi-control start
            ready=false
            for ((attempt = 0; attempt < 50; attempt++)); do
                if tmux -S "$socket" has-session -t '=rathole' 2>/dev/null; then
                    ready=true
                    break
                fi
                sleep 0.1
            done
            "$ready" || die "rathole tmux session did not start; inspect journalctl -u rathole."
        fi
        exec tmux -S "$socket" attach-session -t '=rathole'
        ;;
    check|status|install|update) ;;
    *) usage >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || die "unexpected arguments"
for tool in curl jq dpkg sha256sum flock ldd; do
    command -v "$tool" >/dev/null || die "missing $tool; run setup.sh first."
done

root="$HOME/.local/share/freqhole-pi"
binary="$HOME/.local/bin/rathole"
mkdir -p "$root" "$(dirname "$binary")"
exec 9>"$root/update.lock"
flock -n 9 || die "another setup/update is running."
case "$(dpkg --print-architecture)" in
    arm64) arch=aarch64 ;;
    armhf) arch=armv7 ;;
    *) die "supported architectures: arm64 and armhf." ;;
esac

work="$(mktemp -d "$root/download.XXXXXX")"
staged=""
stopped=false
cleanup() {
    if [ -n "$staged" ]; then rm -f -- "$staged"; fi
    rm -f -- "$work/release.json" "$work/rathole" "$work/installed.json" "$work/ldd.txt"
    rmdir -- "$work"
    if "$stopped"; then
        echo "update did not finish restarting rathole; check journalctl -u rathole before retrying." >&2
    fi
}
trap cleanup EXIT
[ "$action" = status ] || echo "checking latest rathole release..."
curl -fsSL --retry 1 --connect-timeout 5 --max-time 15 \
    https://api.github.com/repos/freqhole/tomb/releases/latest -o "$work/release.json"
tag="$(jq -er '.tag_name' "$work/release.json")" || die "release response has no tag."
version="${tag#v}"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "unexpected stable release version: $tag"
name="rathole_${version}_linux-${arch}"
asset="$(jq -ce --arg name "$name" '.assets | map(select(.name == $name)) |
    if length == 1 then .[0] else error("release has no unique asset for this architecture") end' \
    "$work/release.json")"
url="$(jq -er '.browser_download_url' <<< "$asset")" || die "release asset has no download URL."
digest="$(jq -er '.digest' <<< "$asset")" || die "release asset has no SHA-256 digest."
[[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "release is missing a SHA-256 digest."
[ "$url" = "https://github.com/freqhole/tomb/releases/download/$tag/$name" ] \
    || die "unexpected release download URL."

installed=none
if [ -f "$binary" ]; then
    [ -f "$root/installed.json" ] || die "existing rathole is unmanaged; move it aside or use its original updater."
    installed="$(jq -er '.version' "$root/installed.json")" || die "install record has no version."
    [[ "$installed" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
        || die "could not read the installed rathole version."
    expected="$(jq -er '.sha256' "$root/installed.json")" || die "install record has no binary hash."
    actual="$(sha256sum "$binary" | awk '{print $1}')"
    [ "$actual" = "$expected" ] || die "rathole differs from its install record; refusing to overwrite it."
fi
newer=true
if [ "$installed" != none ]; then
    if dpkg --compare-versions "$installed" ge "$version"; then
        newer=false
    fi
fi
if [ "$action" = status ]; then
    jq -n --arg installed "$installed" --arg available "$version" --argjson newer "$newer" \
        '{installed: $installed, available: $available, update_available: $newer}'
    exit 0
fi
echo "rathole: installed $installed; available $version"
if ! "$newer"; then echo "no newer stable release."; exit 0; fi
if [ "$action" = check ]; then
    echo "update available; run: freqhole-pi update"
    exit 0
fi

echo "downloading rathole $version..."
# the progress bar goes to stderr; the OLED menu shows its percentage.
curl -fSL -# --retry 2 --connect-timeout 15 --max-time 900 "$url" -o "$work/rathole"
echo "verifying rathole checksum..."
printf '%s  %s\n' "${digest#sha256:}" "$work/rathole" | sha256sum -c -
chmod 755 "$work/rathole"
echo "checking rathole runtime libraries..."
if ! ldd "$work/rathole" > "$work/ldd.txt" 2>&1 || grep -q 'not found' "$work/ldd.txt"; then
    cat "$work/ldd.txt" >&2
    die "release runtime dependencies are incompatible or missing; existing rathole was not stopped."
fi
jq -n --arg version "$version" --arg sha256 "${digest#sha256:}" \
    '{version: $version, sha256: $sha256}' > "$work/installed.json"

running=false
if ! unit_state="$(systemctl show rathole.service --property=ActiveState --value)"; then
    # an absent unit can report inactive with a nonzero status on first install.
    [ "$unit_state" = inactive ] || die "could not inspect rathole.service; existing binary was not replaced."
fi
case "$unit_state" in
    active) running=true ;;
    inactive|failed) ;;
    *) die "rathole service is $unit_state; retry when it has stopped transitioning." ;;
esac
if [ -f "$binary" ]; then
    cp -p "$binary" "$root/rathole.previous"
    cp -p "$root/installed.json" "$root/installed.previous.json"
fi
# stage beside the destination so the final replacement is a single rename.
staged="$(mktemp "$HOME/.local/bin/.rathole.XXXXXX")"
install -m 755 "$work/rathole" "$staged"
if "$running"; then
    echo "stopping rathole..."
    sudo -n /usr/local/libexec/freqhole-pi-control stop
    stopped=true
fi
echo "installing rathole $version..."
mv -f "$staged" "$binary"
staged=""
mv -f "$work/installed.json" "$root/installed.json"
if "$running"; then
    echo "starting rathole..."
    if ! sudo -n /usr/local/libexec/freqhole-pi-control start; then
        die "restart failed; previous binary: $root/rathole.previous. check journalctl -u rathole."
    fi
    sleep 2
    if ! systemctl is-active --quiet rathole.service; then
        die "rathole exited after restart; previous binary: $root/rathole.previous. check journalctl -u rathole."
    fi
    stopped=false
fi
echo "installed rathole $version; existing configuration/data were retained."
