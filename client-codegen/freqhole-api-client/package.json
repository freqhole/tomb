{
  "name": "@freqhole/api-client",
  "version": "0.1.35",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/freqhole/tomb"
  },
  "main": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./storage": "./src/storage/index.ts",
    "./automerge": "./src/automerge/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx src/test.ts",
    "test:coverage": "SKIP_INTEGRATION=true tsx src/test.ts",
    "test:integration": "tsx src/test.ts",
    "auth-test": "vite --config vite.config.js"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@automerge/automerge-repo": "^2.5.5"
  },
  "peerDependenciesMeta": {
    "@automerge/automerge-repo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@automerge/automerge-repo": "^2.5.6",
    "@tauri-apps/api": "^2.11.1",
    "@types/node": "^25.0.8",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  }
}
