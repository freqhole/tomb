<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.freqhole.freqhole</id>

  <name>freqhole</name>
  <summary>self-hosted media library with P2P streaming</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="net.freqhole">
    <name>freqhole</name>
  </developer>

  <description>
    <p>
      freqhole is a self-hosted media server with peer-to-peer sharing.
      run your own server, scan your music library, and stream anywhere.
      share with friends using P2P connections — no port forwarding needed.
    </p>
    <p>features:</p>
    <ul>
      <li>self-hosted media library with SQLite backend</li>
      <li>P2P streaming via iroh — works through NAT</li>
      <li>offline support with local caching</li>
      <li>MusicBrainz integration for metadata enrichment</li>
      <li>web app for remote access</li>
      <li>invite-based access control</li>
    </ul>
  </description>

  <launchable type="desktop-id">net.freqhole.freqhole.desktop</launchable>
  <!-- deb/rpm ship the same metainfo but keep tauri's plain desktop-file name -->
  <launchable type="desktop-id">freqhole.desktop</launchable>

  <url type="homepage">https://freqhole.net</url>
  <url type="bugtracker">https://github.com/freqhole/tomb/issues</url>
  <url type="vcs-browser">https://github.com/freqhole/tomb</url>
  <url type="help">https://freqhole.net</url>

  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#f5d0fe</color>
    <color type="primary" scheme_preference="dark">#c026d3</color>
  </branding>

  <!-- served from freqhole.net/public/screenshots/ - the URLs must resolve
       publicly or software centers show nothing. see that folder's README -->
  <screenshots>
    <screenshot type="default">
      <caption>browse your library by artist</caption>
      <image>https://freqhole.net/screenshots/artists.png</image>
    </screenshot>
    <screenshot>
      <caption>explore the library as a force-directed graph of tags and relations</caption>
      <image>https://freqhole.net/screenshots/explore.png</image>
    </screenshot>
    <screenshot>
      <caption>listen along to shared radio stationz</caption>
      <image>https://freqhole.net/screenshots/radio.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <!-- add a new entry per tagged release; software centers show these as
         release notes next to the version number -->
    <release version="0.2.15" date="2026-08-22" type="stable">
      <description>
        <p>removable media sync: pick music with radio filters and write it to external storage, optionally re-encoded.</p>
      </description>
    </release>
    <release version="0.1.12" date="2026-03-24" type="stable">
      <description>
        <p>P2P federation support and documentation site launch.</p>
      </description>
    </release>
  </releases>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
    <category>Music</category>
  </categories>

  <keywords>
    <keyword>music</keyword>
    <keyword>audio</keyword>
    <keyword>library</keyword>
    <keyword>server</keyword>
    <keyword>streaming</keyword>
    <keyword>p2p</keyword>
    <keyword>self-hosted</keyword>
    <keyword>player</keyword>
    <keyword>collection</keyword>
    <keyword>podcast</keyword>
    <keyword>video</keyword>
    <keyword>freqhole</keyword>
  </keywords>

  <provides>
    <binary>freqhole</binary>
  </provides>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
</component>
