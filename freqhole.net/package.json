{
  "name": "freqhole.net",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run gen:installer && npm --prefix ../client/spume ci && npm --prefix ../client/spume run build:coach:wc",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "gen:dates": "node scripts/gen-page-dates.mjs",
    "gen:dates:force": "node scripts/gen-page-dates.mjs --force",
    "gen:installer": "node scripts/sync-installer.mjs",
    "gen:release-assets": "npm run gen:installer && npm run gen:dates",
    "check:installer": "node scripts/sync-installer.mjs --check",
    "gen:schema": "node scripts/gen-schema-diagrams.mjs",
    "check:dates": "node scripts/gen-page-dates.mjs --check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/starlight": "^0.42.7",
    "astro": "^6.0.1",
    "d3": "^7.9.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "astro-mermaid": "^2.2.0",
    "mermaid": "^11.15.0"
  }
}
