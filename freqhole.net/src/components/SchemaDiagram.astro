---
interface Props { source: string; label: string }
const { source, label } = Astro.props;
---

<schema-diagram>
  <div class="toolbar" aria-label={`${label} controls`}>
    <strong>{label}</strong>
    <button type="button" data-zoom="in" aria-label={`zoom in ${label}`}>+</button>
    <button type="button" data-zoom="out" aria-label={`zoom out ${label}`}>-</button>
    <button type="button" data-zoom="fit">fit</button>
  </div>
  <div class="viewport" tabindex="0" role="region" aria-label={`${label}: click a node to zoom, repeat to toggle connected nodes, click background or press Escape for context, drag to pan, + or - to zoom, 0 to fit`}>
    <p class="status" role="status">loading diagram...</p>
    <svg class="canvas" width="100%" height="600" aria-label={label}></svg>
  </div>
  <script is:inline type="application/json" class="source" set:html={JSON.stringify(source).replace(/</g, '\\u003c')} />
</schema-diagram>

<style>
  schema-diagram { display: block; border: 1px solid var(--sl-color-gray-5); margin: 1rem 0 2rem; }
  .toolbar { display: flex; align-items: center; gap: .5rem; padding: .5rem; }
  .toolbar > * { margin-block: 0; }
  .toolbar strong { margin-right: auto; }
  button { display: inline-flex; align-items: center; justify-content: center; min-width: 2.5rem; height: 2.5rem; padding: .25rem .75rem; background: var(--sl-color-gray-6); color: var(--sl-color-text); border: 1px solid var(--sl-color-gray-4); cursor: pointer; }
  .viewport { position: relative; overflow: hidden; touch-action: none; }
  .viewport:focus-visible { outline: 2px solid var(--sl-color-accent); }
  .canvas { display: block; max-width: none; cursor: grab; }
  .canvas:active { cursor: grabbing; }
  .status { position: absolute; padding: 1rem; }
</style>

<script>
  import mermaid from "mermaid";
  import { select, zoom, zoomIdentity, zoomTransform, type ZoomBehavior } from "d3";
  import { graphNodeId, selectGraphNode } from "./schema-selection.mjs";

  let nextId = 0;
  class SchemaDiagram extends HTMLElement {
    private observer?: ResizeObserver;
    private themeObserver?: MutationObserver;
    private generation = 0;

    connectedCallback() {
      void this.renderDiagram();
      this.themeObserver = new MutationObserver(() => void this.renderDiagram());
      this.themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    }

    disconnectedCallback() {
      this.generation++;
      this.observer?.disconnect();
      this.themeObserver?.disconnect();
    }

    private async renderDiagram() {
      const generation = ++this.generation;
      const canvas = this.querySelector<SVGSVGElement>(".canvas")!;
      const status = this.querySelector<HTMLElement>(".status")!;
      const source = JSON.parse(this.querySelector(".source")!.textContent!) as string;
      try {
        mermaid.initialize({
          startOnLoad: false, maxTextSize: 200000, maxEdges: 2000,
          theme: document.documentElement.dataset.theme === "light" ? "default" : "dark",
          er: { useMaxWidth: false }, flowchart: { useMaxWidth: false },
        });
        const diagram = await mermaid.mermaidAPI.getDiagramFromText(source);
        const { edges } = (diagram.db as typeof diagram.db & {
          getData(): { edges: { id: string; start: string; end: string }[] };
        }).getData();
        const diagramId = `schema-${++nextId}`;
        const { svg } = await mermaid.render(diagramId, source);
        if (!this.isConnected || generation !== this.generation) return;
        // mermaid's HTML labels can contain <br>, which isn't XML-safe.
        const template = document.createElement("template");
        template.innerHTML = svg;
        const content = template.content.firstElementChild;
        if (!(content instanceof SVGSVGElement)) throw new Error("invalid SVG element");
        // match mermaid's diagram-ID specificity, including custom view node colors.
        const selectionStyle = document.createElementNS("http://www.w3.org/2000/svg", "style");
        selectionStyle.textContent = `
          #${diagramId} g.node[aria-pressed="true"] .nodeLabel,
          #${diagramId} g.node[aria-pressed="true"] .nodeLabel * { color: #fff !important; }
          #${diagramId} g.node[aria-pressed="true"] text { fill: #fff !important; }
          #${diagramId} path[data-selected-edge] { stroke: #e879f9 !important; stroke-width: 3px !important; }
        `;
        content.append(selectionStyle);
        const box = content.viewBox.baseVal;
        const width = box.width;
        const height = box.height;
        content.removeAttribute("style");
        content.setAttribute("width", String(width));
        content.setAttribute("height", String(height));
        const group = document.createElementNS("http://www.w3.org/2000/svg", "g");
        group.append(content);
        canvas.replaceChildren(group);
        const svgSelection = select(canvas);
        let focusedNode: SVGGElement | undefined;
        let selection: ReturnType<typeof selectGraphNode> | undefined;
        const nodeStyles = new Map<SVGElement, string | null>();
        const nodes = [...content.querySelectorAll<SVGGElement>("g.node")];
        const nodeId = (node: SVGGElement) => node.getAttribute("data-id") || graphNodeId(node.id, diagramId);
        const edgePaths = [...content.querySelectorAll<SVGPathElement>("path[data-edge]")];
        const clearNodeFocus = () => {
          focusedNode?.setAttribute("aria-pressed", "false");
          nodeStyles.forEach((style, shape) => {
            if (style === null) shape.removeAttribute("style");
            else shape.setAttribute("style", style);
          });
          nodeStyles.clear();
          focusedNode = undefined;
          selection = undefined;
          edgePaths.forEach((edge) => edge.removeAttribute("data-selected-edge"));
        };
        const zoomToContext = () => {
          if (!focusedNode) return;
          clearNodeFocus();
          svgSelection.interrupt().transition()
            .duration(matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 250)
            .call(behavior.scaleBy, 1 / 1.4 ** 3);
          this.querySelector<HTMLElement>(".viewport")!.focus({ preventScroll: true });
        };
        const behavior: ZoomBehavior<SVGSVGElement, unknown> = zoom<SVGSVGElement, unknown>()
          .scaleExtent([0.001, 8])
          .clickDistance(4)
          .filter((event) => event.type !== "wheel" || this.querySelector(".viewport")!.contains(document.activeElement))
          .on("zoom", (event) => group.setAttribute("transform", event.transform.toString()));
        svgSelection.call(behavior);
        canvas.onclick = (event) => {
          if (!event.defaultPrevented && event.target instanceof Element && !event.target.closest("g.node")) {
            zoomToContext();
          }
        };
        nodes.forEach((node) => {
          node.style.cursor = "pointer";
          node.setAttribute("tabindex", "0");
          node.setAttribute("role", "button");
          node.setAttribute("aria-pressed", "false");
          node.setAttribute("aria-label", `zoom to ${node.querySelector(".nodeLabel")?.textContent || "node"}`);
          const focusNode = () => {
            const next = selectGraphNode(selection, nodeId(node), edges);
            const rects = nodes.filter((candidate) =>
              next.nodeIds.has(nodeId(candidate)),
            ).map((candidate) => candidate.getBoundingClientRect());
            const left = Math.min(...rects.map((rect) => rect.left));
            const top = Math.min(...rects.map((rect) => rect.top));
            const width = Math.max(...rects.map((rect) => rect.right)) - left;
            const height = Math.max(...rects.map((rect) => rect.bottom)) - top;
            const canvasRect = canvas.getBoundingClientRect();
            const current = zoomTransform(canvas);
            const [x, y] = current.invert([
              left + width / 2 - canvasRect.x,
              top + height / 2 - canvasRect.y,
            ]);
            if (!width || !height) return;
            clearNodeFocus();
            focusedNode = node;
            selection = next;
            node.setAttribute("aria-pressed", "true");
            // view colors use inline !important styles, so preserve and override them here.
            node.querySelectorAll<SVGElement>("rect, polygon, path").forEach((shape) => {
              nodeStyles.set(shape, shape.getAttribute("style"));
              shape.style.setProperty("fill", "#a21caf", "important");
              shape.style.setProperty("stroke", "#f0abfc", "important");
            });
            edgePaths.forEach((edge) => {
              if (next.edgeIds.has(edge.getAttribute("data-id")!)) edge.setAttribute("data-selected-edge", "");
            });
            const scale = Math.max(0.001, Math.min(
              (canvas.clientWidth - 48) * current.k / width,
              552 * current.k / height, 2,
            ));
            svgSelection.interrupt().transition()
              .duration(matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 250)
              .call(behavior.transform, zoomIdentity
                .translate(canvas.clientWidth / 2 - x * scale, 300 - y * scale).scale(scale));
          };
          node.addEventListener("click", (event) => {
            if (!event.defaultPrevented) focusNode();
          });
          node.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              focusNode();
            }
          });
        });
        const fit = () => {
          clearNodeFocus();
          svgSelection.interrupt();
          const available = canvas.clientWidth;
          if (!available || !width || !height) return;
          const scale = Math.min((available - 24) / width, 576 / height, 1);
          svgSelection.call(behavior.transform, zoomIdentity.translate(
            (available - width * scale) / 2, (600 - height * scale) / 2,
          ).scale(scale));
        };
        this.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((button) => {
          button.onclick = () => {
            svgSelection.interrupt();
            if (button.dataset.zoom === "fit") fit();
            else svgSelection.call(behavior.scaleBy, button.dataset.zoom === "in" ? 1.4 : 1 / 1.4);
          };
        });
        const viewport = this.querySelector<HTMLElement>(".viewport")!;
        viewport.onkeydown = (event) => {
          if (event.key === "Escape" && focusedNode) {
            event.preventDefault();
            zoomToContext();
          } else if (["+", "=", "-", "0"].includes(event.key)) {
            event.preventDefault();
            svgSelection.interrupt();
            if (event.key === "0") fit();
            else svgSelection.call(behavior.scaleBy, event.key === "-" ? 1 / 1.4 : 1.4);
          } else if (["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) {
            event.preventDefault();
            svgSelection.interrupt();
            const delta = (event.key === "ArrowLeft" || event.key === "ArrowUp" ? 50 : -50) / zoomTransform(canvas).k;
            svgSelection.call(behavior.translateBy, event.key.includes("Left") || event.key.includes("Right") ? delta : 0,
              event.key.includes("Up") || event.key.includes("Down") ? delta : 0);
          }
        };
        this.observer?.disconnect();
        this.observer = new ResizeObserver(fit);
        this.observer.observe(viewport);
        fit();
        status.hidden = true;
      } catch (error) {
        if (generation !== this.generation) return;
        console.error("schema diagram failed", error);
        status.hidden = false;
        status.textContent = "could not render diagram. reload to retry.";
      }
    }
  }
  if (!customElements.get("schema-diagram")) customElements.define("schema-diagram", SchemaDiagram);
</script>
